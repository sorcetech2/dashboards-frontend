# Auth.js. Generate a unique production value of at least 32 random bytes.
AUTH_SECRET=
# Optional dedicated HMAC key for opaque login-throttle object names.
AUTH_LOGIN_THROTTLE_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Local development/test authentication. Local registries are rejected in production.
AUTH_USER_REGISTRY_SOURCE=local
AUTH_USER_REGISTRY_LOCAL_PATH=./lib/user-registry.json

# Production registry defaults shown explicitly. Keep auth/* private.
AUTH_USER_REGISTRY_BUCKET=sorce-dashboard-data
AUTH_USER_REGISTRY_KEY=auth/users.json
AUTH_USER_REGISTRY_REGION=us-east-1

# Optional throttle overrides. Vercel previews must set both explicitly.
AUTH_LOGIN_THROTTLE_BUCKET=
AUTH_LOGIN_THROTTLE_KEY_PREFIX=auth/rate-limit/

# Local sanitized dashboard fixture root. Production must set this to s3.
SORCE_DATA_SOURCE=local
SORCE_DATA_LOCAL_ROOT=./tests/fixtures/dashboard

# Production dashboard data defaults shown explicitly.
SORCE_DATA_BUCKET=sorce-dashboard-data
SORCE_DATA_REGION=us-east-1
SORCE_TEAM_STATS_KEY=companies/team_stats.json
# Successful reads are cached only after authorization. Valid range: 0-900.
SORCE_DATA_CACHE_SECONDS=60

# Prefer workload identity in production. Static keys are only a local fallback.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
